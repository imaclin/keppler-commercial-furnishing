# Required. Keep this pointed at your LOCAL database.
DATABASE_URL=postgresql://USER@localhost:5432/gs_chairs

# Optional. Outbound email is skipped entirely unless RESEND_API_KEY is set.
# KEPPLER_EMAIL_FROM must use a domain verified in Resend.
# GS_EMAIL_FROM is the pre-rebrand name, still read as a fallback.
# KEPPLER_EMAIL_FROM="Keppler Commercial Furnishing <noreply@example.com>"
# RESEND_API_KEY=
